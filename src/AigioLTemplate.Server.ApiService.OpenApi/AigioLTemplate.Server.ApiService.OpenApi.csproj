<Project Sdk="Microsoft.NET.Sdk.Web">

	<Import Project="..\ApiService.props" />
	<Import Project="..\ApiService.Docker.props" />

	<PropertyGroup>
		<TargetFrameworks>net$(DotNet_Version)</TargetFrameworks>
		<DockerfileTag>aigioltemplate-api-oa6</DockerfileTag>
		<RootNamespace>AigioLTemplate.ApiService.OpenApi</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\AigioLTemplate.Server.Core\AigioLTemplate.Server.Core.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="OpenIddict.Core" />
		<PackageReference Include="OpenIddict.AspNetCore" />
		<PackageReference Include="OpenIddict.EntityFrameworkCore" />
	</ItemGroup>

	<Import Project="..\..\ref\common\src\AigioL.Common.AspNetCore.OpenApi\AigioL.Common.AspNetCore.OpenApi.projitems" Label="Shared" />
	<Import Project="..\..\ref\common\src\AigioL.Common.OpenApi.Signature\AigioL.Common.OpenApi.Signature.projitems" Label="Shared" />

	<ItemGroup>
		<Compile Include="..\AigioLTemplate.Server.ApiService.AdminCenter\Data\AppDbContext.cs">
			<LinkBase>Data</LinkBase>
		</Compile>
		<Compile Include="..\AigioLTemplate.Server.ApiService.AdminCenter\Data\Partials\*.cs">
			<LinkBase>Data\Partials</LinkBase>
		</Compile>
		<Compile Include="..\AigioLTemplate.Server.ApiService.AdminCenter\Data\Partials\OrderingPayment\*.cs">
			<LinkBase>Data\Partials\OrderingPayment</LinkBase>
		</Compile>
		<Compile Include="..\AigioLTemplate.Server.ApiService.AdminCenter\Data\Partials\Payment\*.cs">
			<LinkBase>Data\Partials\Payment</LinkBase>
		</Compile>
	</ItemGroup>

</Project>
